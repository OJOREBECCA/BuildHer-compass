PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Optional: only needed to pull opportunities from a deployed Apify Actor run
# instead of running the scraper locally (see ../apify-actor/README.md).
# The BuildHer Compass Opportunity Intelligence Actor is already deployed at
# https://console.apify.com/actors/v3mqraM83U2weoyzM — set APIFY_ACTOR_ID to
# v3mqraM83U2weoyzM (plus your own APIFY_TOKEN) to sync from real platform
# runs instead of the free local scrape.
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_MAX_ITEMS_PER_CATEGORY=6
